# Environment — never commit. .env is the local file the Tina CLI reads
# (it does not read .env.local), .env.local is the one Next.js reads.
.env
.env.local
.env*.local
!.env.example

# Tina build output. Regenerated by `tinacms build` on every build, local
# and on Vercel. Deliberately NOT committed: the generated client.ts is
# written with TINA_TOKEN inlined in plaintext, and this repo is public.
# tina/tina-lock.json IS committed — Tina Cloud reads the schema from it.
tina/__generated__/
tsconfig.tsbuildinfo
