{
  "name": "placeandplenty-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tinacms dev -c \"next dev\"",
    "build": "tinacms build && node scripts/fix-tina-cache-path.mjs && node scripts/check-tina-codegen.mjs && node scripts/check-app-links.mjs && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:db": "echo \"Run supabase/tests/native-rebuild-contract.sql as one statement batch against the project (Supabase SQL editor, supabase db execute, psql, or the Supabase MCP).\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.45.0",
    "next": "^14.2.25",
    "qrcode-generator": "^2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tinacms": "^2.5.1"
  },
  "devDependencies": {
    "@tinacms/cli": "^1.7.1",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.25",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.4"
  }
}
