# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe web checkout
# Keep web checkout off until all required Stripe values are configured in Vercel
# and the Supabase web-purchase-webhook is registered in Stripe.
PAYMENT_PROCESSOR_SECRET_KEY=
STRIPE_GATHERING_PASS_PRICE_ID=
STRIPE_PLUS_ANNUAL_PRICE_ID=
STRIPE_MULTI_DAY_STANDARD_PRICE_ID=
STRIPE_MULTI_DAY_GATHERING_PASS_PRICE_ID=
STRIPE_MULTI_DAY_PLUS_PRICE_ID=
STRIPE_MULTI_DAY_EXTENSION_PRICE_ID=
NEXT_PUBLIC_SITE_URL=https://placeandplenty.com
STRIPE_BILLING_PORTAL_RETURN_URL=https://placeandplenty.com/host/account

# MailerLite (optional — for syncing new signups to your email engine)
MAILERLITE_API_KEY=

# Checklist request emails (server-only; never use NEXT_PUBLIC_ for these).
# Authenticate placeandplenty.com and verify the sender in Brevo first.
BREVO_API_KEY=
BREVO_CHECKLIST_SENDER=alexis@placeandplenty.com
# Optional edition groups for people who explicitly request hosting emails.
BREVO_HALLOWEEN_LIST_ID=
BREVO_FRIENDSGIVING_LIST_ID=
BREVO_THANKSGIVING_LIST_ID=
BREVO_GAME_DAY_LIST_ID=

# TinaCMS / Tina Cloud (The Coordinated Host content editing)
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

BREVO_DOORBELL_LIST_ID=

# Existing MailerLite account: opt-in interest groups (server only).
MAILERLITE_DOORBELL_GROUP_ID=
MAILERLITE_HALLOWEEN_GROUP_ID=
MAILERLITE_FRIENDSGIVING_GROUP_ID=
MAILERLITE_THANKSGIVING_GROUP_ID=
MAILERLITE_GAME_DAY_GROUP_ID=


# Gelato print fulfillment (server-only)
# Never prefix this key with NEXT_PUBLIC_.
GELATO_API_KEY=


# Paper Suite retail pricing (server-only)
# Sandbox Stripe checkout runs at fulfillment cost so the flow can be tested
# before production margins are locked. Live Stripe keys require a markup.
PAPER_SUITE_MARKUP_PERCENT=
PAPER_SUITE_MIN_MARGIN_CENTS=

# Keep false/blank until production pricing, product mappings and fulfillment QA are approved.
# Stripe test mode always creates Gelato draft orders only.
PAPER_SUITE_FULFILLMENT_ENABLED=
