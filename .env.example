# Supabase (waitlist + Founding Host application storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Turnstile (public web signup bot challenge)
# This site key only renders the browser challenge. Enforcement also requires
# Supabase Auth CAPTCHA protection to be enabled with the matching Turnstile secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# MailerLite (optional — for syncing new signups to your email engine)
MAILERLITE_API_KEY=

# TinaCMS / Tina Cloud (The Coordinated Host content editing)
# Get these from app.tina.io after connecting this repo as a project.
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=
